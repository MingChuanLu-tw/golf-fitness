  "exercises": {
    "standing_open_book": {
      "name": "站姿開書式",
      "new": true,
      "cue": "雙腳與肩同寬、膝蓋微彎，雙手在胸前伸直合掌；一手往後打開，眼睛跟著手，骨盆不動",
      "breath": "轉開時吐氣",
      "video": "https://www.youtube.com/watch?v=qIFcsrA7c5Y",
      "video_note": ""
    },
    "dowel_hinge": {
      "name": "球桿 hip hinge",
      "new": false,
      "cue": "後腦、上背、尾椎三點不離桿",
      "breath": "起身時吐氣",
      "video": "https://www.youtube.com/watch?v=PG67O49Hsso",
      "video_note": "體能計畫書影片庫的影片"
    },
    "club_turn": {
      "name": "持桿擊球姿勢轉身",
      "new": false,
      "cue": "雙手持桿橫放在肩後，擺好擊球姿勢；維持前傾角，轉的是胸椎不是腰",
      "breath": "轉時吐氣",
      "video": "https://www.youtube.com/shorts/EkBb5GQULUE",
      "video_note": "Shorts 短片；球桿放在肩上轉身"
    },
    "trunk_turn": {
      "name": "徒手轉體",
      "new": false,
      "cue": "擊球姿勢、雙手交叉抱胸；骨盆不動",
      "breath": "轉時吐氣",
      "video": "https://www.youtube.com/watch?v=UUf4lRUf1FY",
      "video_note": "手的位置可能和「雙手交叉抱胸」不同"
    },
    "overhead_sidebend": {
      "name": "持桿過頂側彎",
      "new": true,
      "cue": "雙手握住球桿兩端，舉到頭上，手臂打直；往一側慢慢側彎，停 2 秒再回正",
      "breath": "側彎時吐氣",
      "video": "https://www.youtube.com/watch?v=bQHU0sQRc5Y",
      "video_note": "不確定有沒有用球桿",
      "caution": "側彎只做到感覺伸展的幅度"
    },
    "hip_rotation": {
      "name": "持桿髖關節轉動",
      "new": true,
      "cue": "一手扶著直立的球桿，單腳站；另一腳抬起，膝蓋 90°，大腿不動，小腿慢慢往外再往內轉",
      "breath": "持續呼吸",
      "video": "https://www.youtube.com/watch?v=Vbhxw-0YcvU",
      "video_note": "不確定有沒有扶東西"
    },
    "practice_swing": {
      "name": "空揮，由半揮到全揮",
      "new": false,
      "cue": "由慢到快",
      "breath": "發力時吐氣",
      "video": "https://www.youtube.com/watch?v=rXMphjfm3Io",
      "video_note": "揮桿教學影片，只當半揮的參考；揮桿動作以教練為準"
    },
